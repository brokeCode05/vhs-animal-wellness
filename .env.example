# Safe local template; supply your own private credentials in .env
APP_NAME="VHS Animal Wellness Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8010
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vhs_laravel
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
BCRYPT_ROUNDS=12
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="VHS Animal Wellness Center"
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
SMS_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
VHS_LOGIN_OTP=true
VHS_EXPOSE_DEV_OTP=false
VHS_TERMS_VERSION=1

# Explicit clinic approval is required before transcripts can be sent to Groq as a SOAP fallback.
AI_GROQ_SCRIBE_BACKUP_ENABLED=false

# Experimental source-linked paraphrase preview; keep disabled until clinically validated.
AI_SCRIBE_SEMANTIC_SUMMARY_ENABLED=false
# Research-only full-transcript draft; doctor review required.
AI_SCRIBE_SINGLE_PASS_ENABLED=false
# Separate privacy approval required before sending transcripts to Groq for review.
AI_SCRIBE_INDEPENDENT_REVIEW_ENABLED=false

# Configure only after the clinic approves a source-transcript retention period.
# Unset means automatic transcript deletion is disabled.
# VHS_SCRIBE_TRANSCRIPT_RETENTION_DAYS=

# Separate feature credentials. Add values locally; never commit real secrets.
# Empty fields retain AI_API_KEY / GROQ_API_KEY for compatibility.
# Gemini: separate projects are needed for separate project quotas.
# Groq: keys in the same organization still share rate limits.
AI_VETTI_API_KEY=
AI_SCRIBE_API_KEY=
GROQ_VETTI_API_KEY=
GROQ_SCRIBE_API_KEY=
